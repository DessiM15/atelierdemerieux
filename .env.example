# ---------------------------------------------------------------------------
# Square — https://developer.squareup.com/apps
# ---------------------------------------------------------------------------
# "sandbox" while building, "production" when Sydney is ready to take money.
SQUARE_ENVIRONMENT=sandbox

# Server-side only. NEVER prefix this with NEXT_PUBLIC_.
SQUARE_ACCESS_TOKEN=

# Safe to expose — the Web Payments SDK needs them in the browser.
NEXT_PUBLIC_SQUARE_APPLICATION_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=

# Server-side mirror of the location, used when creating orders.
SQUARE_LOCATION_ID=

# From the Square dashboard webhook subscription. Used to verify webhook signatures.
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Pinned Square API version. Bump deliberately, never automatically.
SQUARE_API_VERSION=2025-01-23

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Where commission requests and waitlist signups are emailed.
ATELIER_NOTIFICATION_EMAIL=
